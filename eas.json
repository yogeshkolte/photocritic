{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_ENV": "development" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "APP_ENV": "development" }
    },
    "spike": {
      "extends": "preview",
      "env": { "APP_ENV": "development", "EXPO_PUBLIC_SPIKES": "1" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "APP_ENV": "production" }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": { "track": "internal" }
    }
  }
}
