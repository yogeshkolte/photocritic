{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yogeshkolte/photocritic/shared/remote-config/schema.json",
  "title": "PhotoCritic Remote Config (design \u00a78)",
  "description": "Plain object {parameterName: parsedJsonValue}. Cross-field rules (allowlist, replacementId, consent versions) are checked by tools/validate-config.ts and by each app's validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_meta",
    "kill_switch",
    "providers",
    "models",
    "consent_texts",
    "privacy_policy"
  ],
  "$defs": {
    "providerId": {
      "enum": [
        "openai",
        "anthropic",
        "gemini"
      ]
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 500
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "displayName",
        "baseUrl",
        "keyHelpUrl",
        "consentTextVersion"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "displayName": {
          "$ref": "#/$defs/nonEmpty"
        },
        "baseUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "keyHelpUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "consentTextVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "consentText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "effectiveDate",
        "summary",
        "policyUrl"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "effectiveDate": {
          "$ref": "#/$defs/date"
        },
        "summary": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/nonEmpty"
          }
        },
        "policyUrl": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    }
  },
  "properties": {
    "config_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configVersion",
        "publishedAt"
      ],
      "properties": {
        "configVersion": {
          "type": "integer",
          "minimum": 1
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "kill_switch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appDisabled",
        "message",
        "minSupportedAppVersion",
        "updateUrl",
        "disabledProviders",
        "disabledModels",
        "bannerMessage",
        "reportsDisabled"
      ],
      "properties": {
        "appDisabled": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "minSupportedAppVersion": {
          "$ref": "#/$defs/semver"
        },
        "updateUrl": {
          "anyOf": [
            {
              "$ref": "#/$defs/httpsUrl"
            },
            {
              "const": ""
            }
          ]
        },
        "disabledProviders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/providerId"
          },
          "uniqueItems": true
        },
        "disabledModels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "uniqueItems": true
        },
        "bannerMessage": {
          "type": "string",
          "maxLength": 300
        },
        "reportsDisabled": {
          "type": "boolean"
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openai",
        "anthropic",
        "gemini"
      ],
      "properties": {
        "openai": {
          "$ref": "#/$defs/provider"
        },
        "anthropic": {
          "$ref": "#/$defs/provider"
        },
        "gemini": {
          "$ref": "#/$defs/provider"
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "id",
          "displayName",
          "label",
          "maxLongEdgePx",
          "maxBytes",
          "imageDetail",
          "maxOutputTokens",
          "thinkingLevel",
          "contextTokens",
          "status",
          "replacementId",
          "minAppVersion"
        ],
        "properties": {
          "provider": {
            "$ref": "#/$defs/providerId"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
          },
          "displayName": {
            "$ref": "#/$defs/nonEmpty"
          },
          "label": {
            "enum": [
              "Fast",
              "Best",
              ""
            ]
          },
          "maxLongEdgePx": {
            "type": "integer",
            "minimum": 256,
            "maximum": 8192
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 10000,
            "maximum": 20000000
          },
          "imageDetail": {
            "enum": [
              "low",
              "high",
              "auto",
              "MEDIA_RESOLUTION_LOW",
              "MEDIA_RESOLUTION_MEDIUM",
              "MEDIA_RESOLUTION_HIGH",
              "none"
            ]
          },
          "maxOutputTokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128000
          },
          "thinkingLevel": {
            "enum": [
              "",
              "low",
              "medium",
              "high"
            ]
          },
          "contextTokens": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 10000000
          },
          "status": {
            "enum": [
              "active",
              "preview",
              "deprecated",
              "retired"
            ]
          },
          "replacementId": {
            "type": "string",
            "maxLength": 100
          },
          "minAppVersion": {
            "$ref": "#/$defs/semver"
          }
        }
      }
    },
    "consent_texts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openai",
        "anthropic",
        "gemini"
      ],
      "properties": {
        "openai": {
          "$ref": "#/$defs/consentText"
        },
        "anthropic": {
          "$ref": "#/$defs/consentText"
        },
        "gemini": {
          "$ref": "#/$defs/consentText"
        }
      }
    },
    "privacy_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "url"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/httpsUrl"
            },
            {
              "const": ""
            }
          ]
        }
      }
    }
  }
}
